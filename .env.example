# Copy this file to .env and fill in your values for local development.
# On Netlify: add these in Site settings → Environment variables (never commit the real .env file).

# ── Required ──────────────────────────────────────────────────────────────────
# Your AI API key.  Default provider is Google Gemini (free tier available).
# Get one at: https://aistudio.google.com/app/apikey
AI_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the model (default: gemini-1.5-flash for Gemini, gpt-4o-mini for OpenAI keys).
# AI_MODEL=gemini-1.5-flash

# Use a different OpenAI-compatible endpoint (leave blank to use Google Gemini).
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Comma-separated list of allowed origins for the /api/ai endpoint.
# Leave blank if your front end and function share the same Netlify site URL.
# ALLOWED_ORIGIN=https://your-site.netlify.app
